{
  "name": "gestiopro",
  "version": "1.0.0",
  "description": "GestioPro desktop & web",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "vite build && electron-builder"
  },
  "keywords": [],
  "author": "DennisTurco",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "html2pdf.js": "^0.14.0",
    "marked": "^18.0.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.2",
    "typescript": "^7.0.2",
    "vite": "^8.0.16",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "it.dotblue.gestiopro",
    "productName": "GestioPro",
    "afterPack": "build/after-pack.cjs",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*"
    ],
    "win": {
      "target": "dir",
      "icon": "public/icon.ico",
      "extraResources": [
        {
          "from": "../GestioPro.Api/bin/Release/net10.0/win-x64/publish/",
          "to": "backend",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "public/icon.png",
      "category": "Office",
      "maintainer": "Dennis Turco <d.turco@dotblue.it>",
      "synopsis": "Business management for freelancers and self-employed professionals",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "extraResources": [
        {
          "from": "../GestioPro.Api/bin/Release/net10.0/linux-x64/publish/",
          "to": "backend",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "public/icon.png",
      "category": "public.app-category.business",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "extraResources": [
        {
          "from": "../GestioPro.Api/bin/Release/net10.0/osx-${arch}/publish/",
          "to": "backend",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libayatana-appindicator3-1 | libappindicator3-1"
      ]
    }
  },
  "homepage": "https://github.com/DennisTurco/GestioPro"
}
