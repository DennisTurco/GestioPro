{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Website",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run dev",
            "cwd": "${workspaceFolder}/frontend",

            "serverReadyAction": {
                "pattern": ".*",
                "uriFormat": "http://localhost:3000",
                "action": "openExternally"
            }
        },
        {
            "name": "Run Desktop",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run electron:dev",
            "cwd": "${workspaceFolder}/frontend",
        }
    ]
}