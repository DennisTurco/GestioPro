{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Avvia tutto",
            "dependsOn": [
                "DB: avvia container",
                "Backend: dotnet run",
                "Frontend: vite dev"
            ],
            "dependsOrder": "parallel",
            "problemMatcher": []
        },
        {
            "label": "DB: avvia container",
            "type": "shell",
            "command": "docker start postgres-gestiopro",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "avvia-tutto"
            },
            "problemMatcher": []
        },
        {
            "label": "Backend: dotnet run",
            "type": "shell",
            "command": "dotnet run --project GestioPro.Api --launch-profile https",
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "avvia-tutto"
            },
            "problemMatcher": {
                "pattern": {
                    "regexp": "."
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Building\\.\\.\\.",
                    "endsPattern": "Application started\\."
                }
            }
        },
        {
            "label": "Frontend: vite dev",
            "type": "shell",
            "command": "npm run dev",
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            },
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "avvia-tutto"
            },
            "problemMatcher": {
                "pattern": {
                    "regexp": "."
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "VITE",
                    "endsPattern": "ready in"
                }
            }
        }
    ]
}
